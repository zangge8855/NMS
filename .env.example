# NMS Configuration
PORT=3000
NODE_ENV=production

# Authentication & Security
JWT_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
CREDENTIALS_SECRET=
ENFORCE_STRICT_SECURITY=false
TRUST_PROXY=loopback

# Storage
DATA_DIR=data

# Optional Database (PostgreSQL)
DB_ENABLED=false
DB_URL=
DB_SCHEMA=nms
DB_POOL_MAX=10
DB_SSL_MODE=disable

# Optional Telegram Notifications
TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional SMTP Mailer
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Subscriptions
SUB_PUBLIC_BASE_URL=
