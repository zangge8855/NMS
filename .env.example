# NMS Configuration
# Copy to .env (or pass with `docker run --env-file .env`) and fill in the blanks.
PORT=3001
NODE_ENV=production

# Authentication & Security
#
# JWT_SECRET / CREDENTIALS_SECRET: leave empty and NMS generates strong random
# values on first start, saved to ${DATA_DIR}/runtime.env. Back that file up with
# the data directory: without CREDENTIALS_SECRET, stored node credentials and
# encrypted backups cannot be decrypted. To manage them yourself, set two
# different values of at least 32 characters (e.g. `openssl rand -base64 48`).
JWT_SECRET=
CREDENTIALS_SECRET=
# Session JWT lifetime:
# - JWT_EXPIRES_IN applies to tab-only sessions (unchecked "Keep me signed in").
# - JWT_PERSISTENT_EXPIRES_IN applies to persistent local sessions (checked by default;
#   active sessions also slide-renew automatically on visit, or set to "never" for non-expiring).
# JWT_EXPIRES_IN=24h
# JWT_PERSISTENT_EXPIRES_IN=365d
#
# Required in production: a non-default username (not admin/administrator/root)
# and a password of at least 8 characters spanning 3 of lowercase, uppercase,
# digits and symbols. Startup refuses weak values.
ADMIN_USERNAME=
ADMIN_PASSWORD=
#
# Keep strict mode on in production. It rejects weak secrets and credentials at startup.
ENFORCE_STRICT_SECURITY=true
TRUST_PROXY=loopback

# Storage
DATA_DIR=data

# Optional Database (PostgreSQL)
DB_ENABLED=false
DB_URL=
DB_SCHEMA=nms
DB_POOL_MAX=10
# disable | require (encrypted, server certificate not checked) | verify-full (encrypted and verified; recommended)
DB_SSL_MODE=disable
# PEM file with the CA that signed the database certificate (used by verify-full)
DB_SSL_CA_FILE=

# Optional Telegram Notifications
TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional SMTP Mailer
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Subscriptions
SUB_PUBLIC_BASE_URL=
# Pre-token subscription URLs (/api/subscriptions/public/<email>/<signature>) never
# expire and cannot be revoked per link. Enable only while migrating old clients.
SUB_LEGACY_SIGNATURE_ENABLED=false

# Audit storage limits (optional; defaults shown). Oldest records are dropped
# first once a cap is reached. security_audit.log rotates by size and keeps
# AUDIT_LOG_MAX_FILES old files (security_audit.log.1 ... .N).
# AUDIT_RETENTION_DAYS=365
# AUDIT_MAX_EVENTS=50000
# AUDIT_MAX_SUBSCRIPTION_ACCESS_RECORDS=100000
# AUDIT_LOG_MAX_MB=20
# AUDIT_LOG_MAX_FILES=5
